{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yanyumail",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "keep_vars": true,
  "observability": { "enabled": true },
  "kv_namespaces": [
    { "binding": "MAIL", "id": "REPLACE_WITH_KV_NAMESPACE_ID" },
  ],
  "durable_objects": {
    "bindings": [{ "name": "INBOX", "class_name": "Mailbox" }],
  },
  "migrations": [{ "tag": "mailbox-v1", "new_sqlite_classes": ["Mailbox"] }],
}
